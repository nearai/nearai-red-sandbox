+    #[test]
+    fn partial_delivery_then_a_hard_error_or_zero_write_fails_the_stream() {
+        struct FailsAfterPrefix {
+            prefix: Vec<u8>,
+            error: Option<ErrorKind>,
+        }
+        impl Write for FailsAfterPrefix {
+            fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+                if self.prefix.is_empty() {
+                    self.prefix.extend_from_slice(&bytes[..2]);
+                    Ok(2)
+                } else if let Some(error) = self.error {
+                    Err(error.into())
+                } else {
+                    Ok(0)
+                }
+            }
+            fn flush(&mut self) -> std::io::Result<()> {
+                Ok(())
+            }
+        }
+        for error in [Some(ErrorKind::BrokenPipe), None] {
+            let mut sink = FailsAfterPrefix {
+                prefix: Vec::new(),
+                error,
+            };
+            let mut backlog = HostWriteBacklog::default();
+            assert_eq!(backlog.submit(&mut sink, b"abcdef"), HostWrite::Failed);
+            assert_eq!(sink.prefix, b"ab");
+        }
+    }
