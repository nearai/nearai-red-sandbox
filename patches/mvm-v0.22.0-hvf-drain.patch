 //! writes/removes a PID file so the backend can confirm launch and stop/status
 //! the VM. macOS / Apple-silicon only; a stub elsewhere so the workspace links.
 
+fn rts_vsock_drain_probe(args: impl Iterator<Item = std::ffi::OsString>) -> Option<&'static str> {
+    args.skip(1)
+        .any(|arg| arg == "--rts-vsock-drain-fix-version")
+        .then_some("rts-vsock-drain-v1")
+}
+
+fn exit_with_rts_vsock_drain_probe_if_requested() {
+    if let Some(version) = rts_vsock_drain_probe(std::env::args_os()) {
+        println!("{version}");
+        std::process::exit(0);
+    }
+}
+
