+    fn established_agent() -> (tempfile::TempDir, VsockShared, UnixStream, VsockHdr) {
+        let dir = tempfile::tempdir().unwrap();
+        let sock = dir.path().join("agent.sock");
+        let mut device = dev();
+        device.set_agent_socket(&sock).unwrap();
+        let client = UnixStream::connect(&sock).unwrap();
+        client.set_nonblocking(true).unwrap();
+        device.service_host_io();
+        let (request, _) = device.transport.pending_rx.pop_front().unwrap();
+        assert_eq!(request.op, OP_REQUEST);
+        let reply = VsockHdr {
+            src_cid: GUEST_CID,
+            dst_cid: HOST_CID,
+            src_port: request.dst_port,
+            dst_port: request.src_port,
+            typ: TYPE_STREAM,
+            op: OP_RESPONSE,
+            buf_alloc: HOST_BUF_ALLOC,
+            ..Default::default()
+        };
+        device.handle_packet(reply, &[]);
+        (dir, device, client, reply)
+    }
+
+    #[test]
+    fn agent_shutdown_delivers_queued_response_before_eof() {
+        use std::io::Read;
+        let (_dir, mut device, mut client, mut hdr) = established_agent();
+        let payload: Vec<u8> = (0..HOST_BUF_ALLOC).map(|i| (i % 251) as u8).collect();
+        hdr.op = OP_RW;
+        hdr.len = payload.len() as u32;
+        device.handle_packet(hdr, &payload);
+        assert!(
+            device.handlers.has_host_backlog(),
+            "exercise a saturated socket"
+        );
+        hdr.op = OP_SHUTDOWN;
+        hdr.len = 0;
+        hdr.flags = 3;
+        device.handle_packet(hdr, &[]);
+        device.handle_packet(hdr, &[]);
+
+        let mut received = Vec::new();
+        let mut buf = [0; 65536];
+        for _ in 0..1024 {
+            device.service_host_io();
+            match client.read(&mut buf) {
+                Ok(0) => break,
+                Ok(n) => received.extend_from_slice(&buf[..n]),
+                Err(err) if err.kind() == std::io::ErrorKind::WouldBlock => {}
+                Err(err) => panic!("response read failed: {err}"),
+            }
+        }
+        assert_eq!(
+            received.len(),
+            payload.len(),
+            "shutdown truncated the response"
+        );
+        assert_eq!(received, payload);
+        assert_eq!(
+            client.read(&mut buf).unwrap(),
+            0,
+            "EOF follows the final byte"
+        );
+        assert!(!device.handlers.is_agent_stream(hdr.dst_port));
