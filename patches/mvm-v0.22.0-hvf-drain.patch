+            "--contract-version",
+        ];
+        assert_eq!(
+            rts_vsock_drain_probe(args.into_iter().map(std::ffi::OsString::from)),
+            Some("rts-vsock-drain-v1")
+        );
+    }
+
+    #[test]
+    fn rts_vsock_drain_probe_requires_an_exact_flag_after_executable() {
+        for args in [
+            vec!["supervisor"],
+            vec!["supervisor", "--contract-version"],
+            vec!["--rts-vsock-drain-fix-version"],
+            vec!["supervisor", "--rts-vsock-drain-fix-version=1"],
+        ] {
+            assert_eq!(
+                rts_vsock_drain_probe(args.into_iter().map(std::ffi::OsString::from)),
+                None
+            );
+        }
+    }
+}
