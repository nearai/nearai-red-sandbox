# rts Hyper-V guest kernel: a kconfig fragment merged over `make allnoconfig`
# (x86_64). Built in: VMBus (found through ACPI on x86), hvsocket (vsock +
# hv_sock), a serial console, an initramfs root and loopback TCP for the
# guest's egress proxy. No network device drivers, no block or SCSI
# drivers, no shared-folder filesystems, no PCI, no module loading: the
# guest has nothing to load and nothing to reach but hvsocket. `build.sh`
# checks every line below and the forbidden list.
CONFIG_64BIT=y
# EXPERT only unlocks turning CONFIG_BLOCK off.
CONFIG_EXPERT=y
CONFIG_SMP=y
CONFIG_PRINTK=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_POSIX_TIMERS=y
CONFIG_FILE_LOCKING=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_ACPI=y
CONFIG_HYPERV=y
CONFIG_HYPERV_VMBUS=y
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_VSOCKETS=y
CONFIG_HYPERV_VSOCKETS=y
# CONFIG_MODULES is not set
# CONFIG_PCI is not set
# CONFIG_NETDEVICES is not set
# CONFIG_BLOCK is not set
# CONFIG_VSOCKETS_LOOPBACK is not set
